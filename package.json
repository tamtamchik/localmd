{
  "name": "@tamtamchik/localmd",
  "version": "1.1.0",
  "description": "Serve any folder as a local markdown editor with live preview",
  "type": "module",
  "bin": {
    "localmd": "src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check"
  },
  "keywords": [
    "markdown",
    "editor",
    "local",
    "server",
    "preview",
    "cli"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamtamchik/localmd.git"
  },
  "bugs": {
    "url": "https://github.com/tamtamchik/localmd/issues"
  },
  "homepage": "https://github.com/tamtamchik/localmd#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "codemirror": "5.65.16",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6"
  }
}
